<?xml version="1.0" encoding="UTF-8"?>
<!--
  City Bites Food Management System — Ant Build File
  NetBeans will regenerate nbproject/build-impl.xml automatically when
  the project is first opened.  Until then you can also build/run from
  the command line:

    Compile : ant compile
    Run     : ant run
    Jar     : ant jar
    Clean   : ant clean
-->
<project name="CityBitesFMS" default="run" basedir=".">
    <description>City Bites Food Management System</description>

    <!-- Try to import the NetBeans-generated build implementation.
         If it does not exist yet (first checkout), fall back to the
         simple standalone targets defined below. -->
    <import file="nbproject/build-impl.xml" optional="true"/>

    <!-- ═══════════════════════════════════════════════════════════════
         Standalone Ant targets (used when build-impl.xml is absent)
         ═══════════════════════════════════════════════════════════════ -->

    <property name="src.dir"    value="src"/>
    <property name="build.dir"  value="build/classes"/>
    <property name="dist.dir"   value="dist"/>
    <property name="main.class" value="citybitesfms.Main"/>

    <target name="-standalone-init">
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="-standalone-init"
            description="Compile all Java source files">
        <javac srcdir="${src.dir}"
               destdir="${build.dir}"
               includeantruntime="false"
               source="11" target="11"
               encoding="UTF-8"/>
    </target>

    <target name="jar" depends="compile"
            description="Package the application into a runnable JAR">
        <jar destfile="${dist.dir}/CityBitesFMS.jar" basedir="${build.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
            </manifest>
        </jar>
        <echo message="JAR created: ${dist.dir}/CityBitesFMS.jar"/>
    </target>

    <target name="run" depends="compile"
            description="Compile and run the application">
        <java classname="${main.class}" classpath="${build.dir}" fork="true"/>
    </target>

    <target name="clean" description="Remove all generated artefacts">
        <delete dir="build"/>
        <delete dir="${dist.dir}"/>
    </target>

</project>
